# Copy this file to ".env" and change the values. ".env" must never be shared or committed.

# How to reach PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# (If your password has special characters such as @ or #, choose a simpler password for this demo)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5000/auth-flow-project

# The secret that signs tokens. Use any long random text (at least 16 characters)
JWT_SECRET=your_jwt_secret_here_at_least_16_characters

# The port the website runs on
PORT=5000